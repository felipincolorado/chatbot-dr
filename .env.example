# Copia este archivo como .env SOLO para desarrollo local. Nunca subas .env a Git.
# En Railway, configura estas variables en el panel (Variables).

NODE_ENV=production
# PORT lo asigna Railway automáticamente.

# Twilio (obligatorias en producción para validar la firma del webhook)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Opcional: URL pública exacta del servicio, sin barra final. Si se omite se usa la cabecera del proxy.
PUBLIC_BASE_URL=
# Opcional: solo para emergencias. Por defecto es true en producción.
# TWILIO_VALIDATE_SIGNATURE=true

# Datos públicos de la consulta
AGENDA_URL=https://drsebastianaravena.cl/agendar/
HUMAN_WHATSAPP_NUMBER=56926125661
DOCTOR_FULL_NAME=Dr. Sebastián Aravena
# Solo si el dato fue entregado y verificado. Si se dejan vacías, no se muestran.
DOCTOR_RNPI=
DOCTOR_RNPI_URL=

# IA opcional (desactivada). No activar sin autorización y clave del titular.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=6000
